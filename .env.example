# 复制为 .env 并按需修改后 `export`（服务不会自动读取 .env；compose 只用它做变量插值、
# 不会注入容器——如需注入，取消 docker-compose.yml 中 env_file 一行的注释）。
# 全部配置项都有合理默认值，不设置任何变量也能直接启动。

# ---- HTTP 服务 ----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---- 探测引擎 ----
# 单个目标未显式指定 timeout_ms 时的默认超时（毫秒）
PROBE_DEFAULT_TIMEOUT_MS=3000
# 请求可指定的 timeout_ms 上限（毫秒）
PROBE_MAX_TIMEOUT_MS=10000
# 全局同时在途的 TCP 连接数上限（跨任务共享）
PROBE_MAX_CONCURRENCY=100

# ---- 任务治理 ----
# 单个任务最多目标数
TASK_MAX_TARGETS=200
# 同时存在（未终态）的任务数上限，超出返回 503
TASK_MAX_ACTIVE=100
# 终态任务保留时长（秒）
TASK_TTL_SECONDS=3600
# 内存中最多保留的任务条数
TASK_MAX_RETAINED=1000

# ---- 限流（按来源 IP 的令牌桶）----
RATE_LIMIT_ENABLED=true
# 每秒补充令牌数（即稳态 QPS）
RATE_LIMIT_RPS=5
# 桶容量（允许的瞬时突发）
RATE_LIMIT_BURST=10
# 空闲桶回收时间（秒）
RATE_LIMIT_IDLE_TTL_SECONDS=600

# ---- 请求体限制 ----
# 请求体大小上限（字节），超过返回 413 PAYLOAD_TOO_LARGE
MAX_BODY_BYTES=1048576
